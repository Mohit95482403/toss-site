# ==========================================
# TossArena Backend Environment Configuration
# ==========================================
# Copy this file to .env for local development:
# cp .env.example .env

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS & Frontend Origins
# Comma-separated list of allowed origins or single origin
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tossarena_app
DB_PASSWORD=replace_with_local_password
DB_NAME=tossarena

# Database Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# ------------------------------------------
# FUTURE PHASE CONFIGURATION PLACEHOLDERS
# ------------------------------------------

# Session & Authentication Configuration (Planned Day 3)
SESSION_SECRET=your_random_session_secret_change_in_production
SESSION_NAME=tossarena.sid
SESSION_MAX_AGE_MS=86400000

# Security / Rate Limiting (Planned Future Phase)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
