# ==========================================
# TossArena Backend Environment Configuration
# ==========================================
# Copy this file to .env for local development:
# cp .env.example .env

# Server Configuration (Day 1)
NODE_ENV=development
PORT=5000

# CORS & Frontend Origins (Day 1)
# Comma-separated list of allowed origins or single origin
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# FUTURE PHASE CONFIGURATION PLACEHOLDERS
# ------------------------------------------

# Database Configuration (Planned Day 2 - MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tossarena_db
DB_USER=tossarena_user
DB_PASSWORD=your_secure_db_password_here
DB_CONNECTION_LIMIT=10

# Session & Authentication Configuration (Planned Day 3)
SESSION_SECRET=your_random_session_secret_change_in_production
SESSION_NAME=tossarena.sid
SESSION_MAX_AGE_MS=86400000

# Security / Rate Limiting (Planned Future Phase)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
